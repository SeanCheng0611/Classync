PORT=4000
CLIENT_URL=http://localhost:5173

# 開發用：尚未申請 LINE Login channel 前，可用 DEV_LOGIN=true 走假登入頁測試整套系統
DEV_LOGIN=true

# LINE Login channel (https://developers.line.biz/console/)
# Callback URL 會依實際存取的網址（localhost 或區網 IP）動態決定，兩者都要先在 LINE Console 的
# LINE Login 分頁註冊，例如 http://localhost:4000/auth/line/callback 與 http://<區網IP>:4000/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# 任意一組隨機字串，用來簽發登入 session
JWT_SECRET=change-me-to-a-random-string

# 自動部署 webhook 的共用密鑰：GitHub push 後打 POST /api/deploy-webhook?secret=此值 觸發 git pull
# 留空則此端點一律回傳 403，不會被誤觸發
DEPLOY_WEBHOOK_SECRET=

# 系統管理者模式（Admin Mode，見 docs/ADMIN_MODE.md）：Settings 頁連點標題 10 次會跳出密碼輸入框。
# 實際密碼 = 固定前綴 + 當天日期 MMDD（例如前綴 ABCDEFGH，8/27 當天密碼就是 ABCDEFGH0827，9/1 就是
# ABCDEFGH0901，跟著 server 自己的時鐘每天自動變動，不用手動改這個檔案）。這裡只存「前綴」的雜湊值，
# 不是完整每日密碼，也絕對不要把明文前綴寫進這個檔案或 commit 進 git。
# 產生雜湊值的方式（只丟前綴，不要加日期）：
#   cd server && node -e "import('./src/auth/adminPassword.js').then(m => console.log(m.hashAdminPassword(process.argv[1])))" 你的前綴
# 留空則管理者模式完全無法使用（unlock 一律回傳 500，不是允許任意密碼通過）
ADMIN_MODE_PASSWORD_HASH=
# 解鎖後 Admin Mode 的有效時間（分鐘），預設 45
ADMIN_MODE_SESSION_MINUTES=45
# 密碼尾碼（MMDD）用哪個時區算「今天」，不依賴 Docker host / OS 預設時區，避免跑在 UTC 環境時
# 跟台灣使用者認知的日期差一天。這不是 secret，可以放心留在這裡。
ADMIN_MODE_TIMEZONE=Asia/Taipei
